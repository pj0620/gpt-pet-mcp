{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (schemas only, no ROS)",
      "type": "debugpy",
      "request": "launch",
      "module": "gpt_pet_mcp.main",
      "args": ["--http", "--no-robot"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Offline tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-s", "regression", "-m", "not robot and not server and not parity"],
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    }
  ]
}
