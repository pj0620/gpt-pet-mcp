# Source this (bash) on pj-ubuntu before running the server, in the shell that runs `uv run gpt-pet-mcp --http`:
#   source /opt/ros/humble/setup.bash; source ~/gpt-pet-mcp/env/pj-ubuntu.env
# It mirrors the environment the ROS 2 server launch runs with (tmux session `server`, Fast DDS defaults,
# domain 0, no localhost-only), so this process discovers the robot's nodes the same way the launch does.
source /opt/ros/humble/setup.bash
# The launch runs on domain 0 (no ROS_DOMAIN_ID in its environment). pj-ubuntu's login shell exports
# ROS_DOMAIN_ID=1, which a tmux window inherits, so the domain is forced here, not defaulted.
export ROS_DOMAIN_ID=0
export ROS_LOCALHOST_ONLY=0
unset CYCLONEDDS_URI
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
# the contract's port (gpt-pet-v2 real.ini: http://pj-ubuntu.local:8000/mcp)
export FASTMCP_PORT="${FASTMCP_PORT:-8000}"
export GPTPET_MCP_DETECTOR_DEVICE="${GPTPET_MCP_DETECTOR_DEVICE:-cuda:0}"
